# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fitforge
SPRING_DATASOURCE_USERNAME=fitforge
SPRING_DATASOURCE_PASSWORD=fitforge

# Shared service-to-service auth token; must match SERVICE_TOKEN in backend/.env
SERVICE_TOKEN=

# RevenueCat webhook HMAC secret (required - requests are rejected if unset)
REVENUECAT_WEBHOOK_SECRET=
