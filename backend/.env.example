# Database
DATABASE_URL=postgresql+psycopg://fitforge:fitforge@localhost:5432/fitforge

# Set to false and provide a real SECRET_KEY before deploying anywhere but local dev
DEBUG=true

# Security
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SMTP (dev defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# CORS
CORS_ORIGINS=["*"]

# RevenueCat webhook HMAC secret (required for /api/v1/webhooks/revenuecat to accept requests)
REVENUECAT_WEBHOOK_SECRET=